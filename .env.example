# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Vision Model Provider Key (Anthropic Claude 3.5 Sonnet / GPT-4o / Gemini)
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional alternate providers:
# OPENAI_API_KEY=your-openai-api-key
# GEMINI_API_KEY=your-gemini-api-key

# Admin Setup (Used once by seed script, never read at runtime)
ADMIN_SEED_PASSWORD=010205

# Auth Session Secret
SESSION_SECRET=your-random-32-character-secret-key-ticketscan

# Email Notification Provider (Resend or SendGrid)
# Obtain a free API key at https://resend.com
RESEND_API_KEY=re_your_resend_api_key
# Optional custom sender email (defaults to TicketScan <welcome@ticketscan.app>)
EMAIL_FROM=TicketScan <welcome@ticketscan.app>
